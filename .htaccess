# samuel.tech — regras do servidor (Hostinger / LiteSpeed / Apache)
Options -Indexes
DirectoryIndex index.php index.html
ErrorDocument 404 /404.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Pastas internas: nunca acessíveis direto pela web
  RewriteRule ^(_app|_privado)(/|$) - [F,L]
  # Arquivos dos jogos passam pelo porteiro (exige sessão da família)
  RewriteRule ^jogo/(.+)$ jogo.php?f=$1 [L,QSA]
  # Endereço antigo do jogo
  RewriteRule ^dragoes-e-blocos/?$ /jogar/?jogo=dragoes-e-blocos [R=301,L]
</IfModule>

# Arquivos ocultos (.htaccess, .git…) e de texto/config nunca são servidos
<FilesMatch "(^\.|\.(md|json|sh|py|lock|log|ini)$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"
</IfModule>
